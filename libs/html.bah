#import "iostream.bah"
#import "string.bah"

const HTML_nonClosingTags = []str{
    "meta", 
    "img",
    "!doctype",
    "link",
    "area",
    "base",
    "br",
    "col",
    "embed",
    "hr",
    "input",
    "param",
    "source",
    "track",
    "wbr"
}
const HTML_nonParsingTags = []str{
    "script",
    "style",
    "svg",
    "title"
}

_htmlLazyStrCompare(a str, source str, range [int32,int32]) bool {
    if range[1] - range[0] != len(a) {
        return false
    }

    i=0; for i < len(a), i++ {
        if a[i] != source[range[0] + i] {
            return false
        }
    }

    return true
}

//Represents a html element.
struct htmlElement {
    _from: str

    _name: [int32,int32]
    _html: [int32,int32]
    _text: [int32,int32]

    attrs: []str
    children: []htmlElement*
    parent: htmlElement*

    getName() str {
        return strToLower(this._from[this._name[0]:this._name[1]])
    }


    getText() str {
        if this._text[1] - this._text[0] != 0 {
            return this._from[this._text[0]:this._text[1]]
        }

        text = ""
        i=0; for i < len(this.children), i++ {
            ct = this.children[i].getText()
            if len(ct) == 0 {
                continue
            }

            if len(text) == 0 {
                text += ct
            } else {
                text += " " + ct
            }
        }
        return text
    }

    getHTML() str {
        if this._html[0] == this._html[1] {
            return this.getText()
        }
        return this._from[this._html[0]:this._html[1]]
    }

    //Used for getting the content of the specified attribute.
    getAttr(name str) str {
        i=0; for i < len(this.attrs), i++ {
            attr = this.attrs[i]
            attrName = ""
            found = true
            if len(attr) == 0 {
                continue
            }
            j=0; for j < len(attr), j++ {
                if attr[j] == '=' {
                    if j == 0 {
                        found = false
                    }
                    break
                }

                if j == len(name) {
                    found = false
                    break
                }

                if attr[j] != name[j] {
                    found = false
                    break
                }
            }

            if found == false {
                continue
            }

            if j == len(attr) {
                return "true"
            } else {
                if attr[j+1] == '"' || attr[j+1] == <char>39 {
                    return attr[j+2:len(attr)-1]
                }
                return attr[j+1:]

            }
        }
        return ""
    }

    //Used for finding a children of the element corresponding to the specified query.
    find(q str) []htmlElement* {
        elems = []htmlElement*
        tag str
        qs = string(q)
        oqs = qs
        if qs.count(" ") > 0 {
            tag = splitStringBefore(qs, " ")
        } else {
            tag = q
        }
        fc = tag[0]
        if fc == '.' {
            qs.trimLeft(1)
        }
        i=0; for i < len(this.children) {
            c = this.children[i]
            if fc == '#' {

            } else if fc == '.' {
                cl = c.getAttr("class")
                if strlen(cl) == 0 {
                    i++
                    continue
                }
                classes = splitString(string(cl), " ")
                j=0; for j < len(classes) {
                    class = classes[j]
                    if class.str() == qs.str() {
                        elems[len(elems)] = c
                    }
                    j++
                }
            } else {
                isName = false

                if _htmlLazyStrCompare(tag, c._from, c._name) {
                    qs.trimLeft(strlen(tag))
                    qs.trim()
                    if qs.length > 0 {
                        elems = c.find(qs.str())
                    } else {
                        elems[len(elems)] = c
                    }
                    qs = oqs
                }
            }
            i++
        }
        
        i=0; for i < len(this.children) {
            c = this.children[i]
            es = c.find(q)
            j=0; for j < len(es) {
                elems[len(elems)] = es[j]
                j++
            }
            i++
        }

        return elems
    }

}

//Returns true if the char is either a letter, '-' or '_'
//*Note: this is an internal function.*
isValidHTMLStringChar(c char) bool {
    return isAlphaNumeric(c) || c == '-' || c == '_' || c == '!' || c == ':'
}

//Used for skipping white spaces inside the current char array.
//*Note: this is an internal function.*
skipHTMLspace(s str, i int, to int) int {
    for i < to, i++ {
        if isSpace(s[i]) == false {
            break
        }
    }
    return i
}

//Used for parsing a string. Will return an array of elements.
//*Note: this is an internal function, if you are trying to parse a document, use parseHTML().*
parseHTMLElements(s str, from int, to int, parent htmlElement*) []htmlElement* {
    elems = []htmlElement*

    if to - from <= 0 {
        return null
    }

    from = skipHTMLspace(s, from, to)
    prevPos = from
    i=from; for i < to - 1, i++ {
        if s[i] == '<' && isSpace(s[i+1]) == false {
            prevPos = skipHTMLspace(s, prevPos, to)
            if i - prevPos > 1 {
                elems[len(elems)] = new htmlElement {
                    parent: parent
                    _from: s
                    _text: [<int32>prevPos, <int32>i]
                }
                prevPos = i
            }

            if i + 6 < to && s[i+1] == '!' && s[i+2] == '-' && s[i+3] == '-' {
                i += 4
                for i < to - 2, i++ {
                    if s[i] == '-' && s[i+1] == '-' && s[i+2] == '>' {
                        i += 2
                        break
                    }
                }
                prevPos = i+1
                continue
            }

            // if gap between last element and this one, add a text pseudoelement

            elemStart = i

            i++
            start = i

            elem = new htmlElement {
                parent: parent
                _from: s
            }

            for i < to, i++ {
                if isValidHTMLStringChar(s[i]) == false {
                    break
                }
            }

            elem._name = [<int32>start, <int32>i]

            isSelfClosing = false
            shouldNotParseContent = false
            j=0; for j < len(HTML_nonClosingTags), j++ {
                if _htmlLazyStrCompare(HTML_nonClosingTags[j], s, elem._name) {
                    isSelfClosing = true
                    break
                }
            }

            j=0; for j < len(HTML_nonParsingTags), j++ {
                if _htmlLazyStrCompare(HTML_nonParsingTags[j], s, elem._name) {
                    shouldNotParseContent = true
                    break
                }
            }

            //parsing attributes
            for i < to, i++ {
                i = skipHTMLspace(s, i, to)

                if s[i] == '>' {
                    break
                }

                if i+1 < to && s[i] == '/' && s[i+1] == '>' {
                    isSelfClosing = true
                    i++
                    break
                }

                start = i
                for i < to, i++ {
                    if isValidHTMLStringChar(s[i]) == false {
                        break
                    }
                }

                if i == start {
                    continue
                }

                j = skipHTMLspace(s, i, to)
                if s[j] != '=' {
                    elem.attrs[len(elem.attrs)] = s[start:i]
                    i = j-1
                    continue
                }

                i = skipHTMLspace(s, j + 1, to)
                if s[i] == '"' || s[i] == <char>39 {
                    c = s[i]
                    i++
                    for i < to, i++ {
                        if s[i] == c {
                            i++
                            break
                        }
                    }
                } else {
                    for i < to, i++ {
                        if isValidHTMLStringChar(s[i]) == false {
                            break
                        }
                    }
                }
                elem.attrs[len(elem.attrs)] = s[start:i]
                i--
            }

            i++
            start = i
            contentEnd = i

            if isSelfClosing == false {
                count = 1
                for i < to - 1, i++ {
                    if s[i] == '<' && s[i+1] == '/' {
                        contentEnd = i
                        i += 2
                        j = 0
                        nl = elem._name[1] - elem._name[0]
                        sameTagName = true
                        for i < to, i++ {
                            if isValidHTMLStringChar(s[i]) == false {
                                break
                            }

                            if j >= nl {
                                sameTagName = false
                                break
                            }

                            if s[i] != s[elem._name[0] + j] {
                                sameTagName = false
                                break
                            }

                            j++
                        }

                        for i < to, i++ {
                            if s[i] == '>' {
                                break
                            }
                        }

                        if sameTagName {
                            count--
                            if count == 0 {
                                break
                            }
                        }
                    } else if s[i] == '<' && s[i+1] != '!' {
                        i++

                        j = 0
                        nl = elem._name[1] - elem._name[0]
                        sameTagName = true
                        for i < to, i++ {
                            if isValidHTMLStringChar(s[i]) == false {
                                break
                            }

                            if j >= nl {
                                sameTagName = false
                                break
                            }

                            if s[i] != s[elem._name[0] + j] {
                                sameTagName = false
                                break
                            }

                            j++
                        }

                        for i < to, i++ {
                            if s[i] == '>' {
                                break
                            }
                        }

                        if sameTagName {
                            count++
                        }

                    }
                }
            } else {
                i--
            }

            elem._html = [<int32>elemStart, <int32>i]

            if shouldNotParseContent == false {
                if contentEnd - start > 0 {
                    elem.children = parseHTMLElements(s, start, contentEnd, elem)
                }
            } else {
                elem._text = [<int32>start, <int32>(contentEnd+1)]
            }

            elems[len(elems)] = elem

            prevPos = i+1
            
        }
    }


    prevPos = skipHTMLspace(s, prevPos, to)
    if prevPos < to {
        elems[len(elems)] = new htmlElement {
            parent: parent
            _from: s
            _text: [<int32>prevPos, <int32>to]
        }
    }

    return elems

}

//Used for parsing a HTML document.
//Will return a pointer to the document.
parseHTML(doc str) htmlElement* {
    root = new htmlElement
    // root.name = "document"
    root.children = parseHTMLElements(doc, 0, len(doc), root)
    return root
}