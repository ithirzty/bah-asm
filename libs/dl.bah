#import "iostream.bah"
#import "time.bah"

#cLib "ldl"

#define dlopen(filename char*, flag int32) ptr
#define dlerror() char*
#define dlsym(handle ptr, symbol char*) ptr
#define dlclose(handle ptr) int32

const RTLD_LAZY	  = 0x00001
const RTLD_NOW    = 0x00002

const RTLD_GLOBAL = 0x00100
const RTLD_LOCAL  = 0

const SHT_NULL = 0
const SHT_PROGBITS = 1
const SHT_SYMTAB = 2
const SHT_STRTAB = 3
const SHT_RELA = 4
const SHT_HASH = 5
const SHT_DYNAMIC = 6
const SHT_NOTE = 7
const SHT_NOBITS = 8
const SHT_REL = 9
const SHT_SHLIB = 10
const SHT_DYNSYM = 11
const SHT_INIT_ARRAY = 14
const SHT_FINI_ARRAY = 15
const SHT_PREINIT_ARRAY = 16
const SHT_GROUP = 17
const SHT_SYMTAB_SHNDX = 18
const SHT_LOOS = 0x60000000
const SHT_HIOS = 0x6fffffff
const SHT_LOPROC = 0x70000000
const SHT_HIPROC = 0x7fffffff
const SHT_LOUSER = 0x80000000
const SHT_HIUSER = 0xffffffff

const STT_NOTYPE = 0
const STT_OBJECT = 1
const STT_FUNC = 2
const STT_SECTION = 3
const STT_FILE = 4
const STT_COMMON = 5
const STT_TLS = 6
const STT_LOOS = 10
const STT_HIOS = 12
const STT_LOPROC = 13
const STT_HIPROC = 15

// Elf64_Addr       8 	Unsigned program address
// Elf64_Off 	    8 	Unsigned file offset
// Elf64_Half 	    2 	Unsigned medium integer
// Elf64_Word 	    4 	Unsigned integer
// Elf64_Sword 	    4 	Signed integer
// Elf64_Xword 	    8 	Unsigned long integer
// Elf64_Sxword 	8 	Signed long integer

struct Elf64_Ehdr {
    e_ident: buffer:16
    e_type: uint16
    e_machine: uint16
    e_version: uint32
    e_entry: uint //entry point
    e_phoff: uint //program header offset
    e_shoff: uint //section header offset
    e_flags: uint32 //processor flags
    e_ehsize: uint16 //elf header size
    e_phentsize: uint16 //size of an entry in program header table
    e_phnum: uint16 //number of entries in program header table
    e_shentsize: uint16 //size of an entry in the section header table
    e_shnum: uint16 //number of entries in the section header table
    e_shstrndx: uint16 //section header index of the string table
}

struct Elf64_Shdr {
	sh_name: uint32 //name as index in the string table
	sh_type: uint32 //section type
	sh_flags: uint
	sh_addr: uint //address of the section in the program image
	sh_offset: uint //address as offset in the object file
	sh_size: uint //size of the section
	sh_link: uint32
	sh_info: uint32
	sh_addralign: uint
	sh_entsize: uint
}

struct Elf64_Sym {
	st_name: uint32
	st_info: byte
	st_other: byte
	st_shndx: uint16
	st_value: uint
	st_size: uint
}

struct Elf64_Rela {
	r_offset: uint
	r_info: uint
    r_addend: int
}

struct Elf64_Rel {
	r_offset: uint
	r_info: uint
}

struct objectFileUserSym {
    name: str
    value: ptr
}

struct objectFileGotEntry {
    name: str
    addr: ptr
}

struct objectFile {
    bytes: []byte

    ELFheader: Elf64_Ehdr*
    sectionHeaders: []Elf64_Shdr*
    stringTable: ptr
    symNameTable: ptr
    symbols: []Elf64_Sym*

    textAddress: ptr
    textSize: uint
    textIndex: int
    dataIndex: int
    bssIndex: int
    dataAddress: ptr
    bssAddress: ptr

    got: []objectFileGotEntry

    isDupped: bool

    _getELFstr(index uint) str {
        s = <char*>(<uint>this.stringTable + index)
        return cStrToBah(s)
    }

    _getELFsymName(index uint) str {
        s = <char*>(<uint>this.symNameTable + index)
        return cStrToBah(s)
    }

    _getSectAddress(sectNb int) ptr {
        if sectNb == this.dataIndex {
            return this.dataAddress
        }

        if sectNb == this.bssIndex {
            return this.bssAddress
        }

        if sectNb == this.textIndex {
            return this.textAddress
        }

        sect = this.sectionHeaders[sectNb]
        return <ptr>(<uint>cArr(this.bytes) + sect.sh_offset)
    }

    _getSymAddrFromName(symName str) ptr {
        if symName == "__Bah_panic" {
            return __Bah_panic
        }

        if symName == "bahSleep" {
            return bahSleep
        }

        i=0; for i < len(this.symbols), i++ {
            sym = this.symbols[i]
            lookupName = this._getELFsymName(sym.st_name)
            if lookupName == symName {
                sectnb = sym.st_shndx
                sect = this.sectionHeaders[sectnb]

                if sectnb != this.dataIndex && sectnb != this.bssIndex && sectnb != this.textIndex {
                    continue
                }

                return <ptr>(<uint>this._getSectAddress(sectnb) + sym.st_value)
                // return <ptr>(<uint>cArr(this.bytes) + sym.st_value + sect.sh_offset)
            }
        }

        foundFunc = false
        debugInfos = <uint*>$debug
        for *debugInfos != 0 {
            realFnAddress = *debugInfos
            debugInfos = <uint*>(<uint>debugInfos + 16)
            realsymName = <str>debugInfos

            if symName == realsymName {
                return <ptr>realFnAddress
            }

            debugInfos = <uint*>(<uint>debugInfos + 5 + len(realsymName))
        }
        return null
    }

    _getGotEntry(symName str) objectFileGotEntry* {
        i=0; for i < len(this.got), i++ {
            if this.got[i].name == symName {
                return &this.got[i]
            }
        }
        return null
    }

    performRelocations(section Elf64_Shdr*) {
        j=0; for j * sizeof(Elf64_Rela) < section.sh_size, j++ {
            rel = <Elf64_Rela*>(<uint>cArr(this.bytes) + (section.sh_offset + j * sizeof(Elf64_Rela)))
            symbolNb = rel.r_info >> 32
            sym = this.symbols[rel.r_info >> 32]
            sectnb = sym.st_shndx
            sect = this.sectionHeaders[sectnb]
            relType = <uint32>rel.r_info
            modSect = <Elf64_Shdr*>(<uint>cArr(this.bytes) + (this.ELFheader.e_shentsize * section.sh_info + this.ELFheader.e_shoff))
            addr = <uint32*>(<uint>this._getSectAddress(section.sh_info) + rel.r_offset)

            if relType == 1 { //.data -> .data relocation
                srcAddr = <str><ptr>(<uint>this._getSectAddress(sectnb) + rel.r_addend)
                *(<str*>addr) = srcAddr
            } else if relType == 2 { //data(%rip)
                panic("objectFile: Relocation type data(%rip) is not supported anymore...")
                tdo = <uint>cArr(this.bytes) + sect.sh_offset - <uint>addr
                *addr = tdo + sym.st_value + rel.r_addend
            } else if relType == 4 {
                //function call of function declared inside the objectFile
                fAddr = sym.st_value + rel.r_addend - rel.r_offset
                *addr = fAddr
            } else if relType == 11 {
                //function call by ptr (useful for stubs)
                fnName = this._getELFsymName(sym.st_name)
                realFnAddress = 0

                if fnName == "__Bah_panic" {
                    *addr = <uint>__Bah_panic
                    continue
                }

                foundFunc = false

                debugInfos = <uint*>$debug
                for *debugInfos != 0 {
                    realFnAddress = <uint>debugInfos
                    debugInfos = <uint*>(<uint>debugInfos + 16)
                    realFnName = <str>debugInfos

                    if fnName == realFnName {
                        foundFunc = true
                        break
                    }

                    debugInfos = <uint*>(<uint>debugInfos + 5 + len(realFnName))
                }

                if foundFunc == false {
                    fAddr = sym.st_value + rel.r_addend - rel.r_offset
                    if <uint>rel.r_offset + <uint>fAddr < 16 {
                        println("objectFile: could not link function "+fnName+". If you compiled with -trim, please add the symbol manually with objectFile.setSymbol().")
                    }
                }
                *addr = realFnAddress
            } else if relType == 9 || relType == 41 || relType == 42 {
                //relType == 41 || relType == 42 -> optimization
                // v = g + got + a - p
                p = <uint>addr
                symName = this._getELFsymName(sym.st_name)
                g = this._getGotEntry(symName)
                *addr = <uint>&g.addr + rel.r_addend - p
            } else if relType == 10 {
                //v = s + a
                *addr = <uint>this._getSectAddress(sectnb) + sym.st_value
            }
        }
    }

    _buidGOTtable() {
        i=0; for i < len(this.sectionHeaders), i++ {
            section = this.sectionHeaders[i]
            if section.sh_type == SHT_RELA {
                sectnb = section.sh_info
                if sectnb != this.dataIndex && sectnb != this.bssIndex && sectnb != this.textIndex {
                    continue
                }

                j=0; for j * sizeof(Elf64_Rela) < section.sh_size, j++ {
                    rel = <Elf64_Rela*>(<uint>cArr(this.bytes) + (section.sh_offset + j * sizeof(Elf64_Rela)))
                    symbolNb = rel.r_info >> 32
                    sym = this.symbols[rel.r_info >> 32]
                    sectnb = sym.st_shndx
                    sect = this.sectionHeaders[sectnb]
                    relType = <uint32>rel.r_info
                    modSect = <Elf64_Shdr*>(<uint>cArr(this.bytes) + (this.ELFheader.e_shentsize * section.sh_info + this.ELFheader.e_shoff))
                    addr = <uint32*>(<uint>this._getSectAddress(section.sh_info) + rel.r_offset)

                    if relType != 9 && relType != 41 && relType != 42 {
                        continue
                    }

                    symName = this._getELFsymName(sym.st_name)

                    k=0; for k < len(this.got), k++ {
                        if this.got[k].name == symName {
                            break
                        }
                    }

                    if k == len(this.got) {
                        ga = <Bah_Array_Type*>this.got
                        this.got[k] = objectFileGotEntry {
                            name: symName
                            addr: this._getSymAddrFromName(symName)
                        }
                    }
                }
                
            }
        }
    }

    weakLinker() {
        i=0; for i < len(this.sectionHeaders), i++ {
            section = this.sectionHeaders[i]
            if section.sh_type == SHT_RELA {
                sectnb = section.sh_info
                if sectnb != this.dataIndex && sectnb != this.bssIndex && sectnb != this.textIndex {
                    continue
                }
                this.performRelocations(section)
            }
        }
    }

    _allocateDataSections() {
        i=0; for i < len(this.sectionHeaders), i++ {
            section = this.sectionHeaders[i]
            name = this._getELFstr(section.sh_name)
            if name == ".data" {
                this.dataAddress = <ptr>(<uint>cArr(this.bytes) + section.sh_offset)
                this.dataIndex = i
            } else if name == ".bss" {
                this.bssAddress = <ptr>(<uint>cArr(this.bytes) + section.sh_offset)
                this.bssIndex = i
            }
        }

        ag = <Bah_Array_Type*>this.got

        gotSize = len(this.got) * sizeof(objectFileGotEntry)
        dataSection = this.sectionHeaders[this.dataIndex]
        bssSection = this.sectionHeaders[this.bssIndex]
        textSection = this.sectionHeaders[this.textIndex]
        totalSize = dataSection.sh_size + bssSection.sh_size + textSection.sh_size + gotSize

        memReg = mmap(null, totalSize, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)

        dataAddr = this.dataAddress
        txtAddr = this.textAddress

        this.dataAddress = <ptr>(<uint>memReg)
        this.bssAddress = <ptr>(<uint>this.dataAddress + dataSection.sh_size)
        this.textAddress = <ptr>(<uint>this.bssAddress + bssSection.sh_size)

        memcpy(<ptr>(<uint>this.textAddress + textSection.sh_size), ag.data, gotSize)
        ag.data = <ptr>(<uint>this.textAddress + textSection.sh_size)

        GC_registerRoot(ag.data, gotSize)
        GC_registerRoot(this.dataAddress, dataSection.sh_size)
        GC_registerRoot(this.bssAddress, bssSection.sh_size)

        memcpy(this.dataAddress, dataAddr, dataSection.sh_size)
        memset(this.bssAddress, 0, bssSection.sh_size)
        memcpy(this.textAddress, txtAddr, textSection.sh_size)

        i=0; for i < len(this.got), i++ {
            this.got[i].addr = this._getSymAddrFromName(this.got[i].name)
        }
    }

    open(filePath str) bool {
        fs = fileStream{}
        fs.open(filePath, "rb")
        if fs.isValid() == false {
            return false
        }
        this.bytes = fs.readBytes()
        fs.close()

        if len(this.bytes) < 64 {
            return false
        }

        this.ELFheader = <Elf64_Ehdr*>cArr(this.bytes)
        allocateArray(this.sectionHeaders, this.ELFheader.e_shnum)

        i=0; for i < this.ELFheader.e_shnum, i++ {
            section = <Elf64_Shdr*>(<uint>cArr(this.bytes) + (this.ELFheader.e_shentsize * i + this.ELFheader.e_shoff))
            this.sectionHeaders[i] = section

            if i == this.ELFheader.e_shstrndx && section.sh_type == SHT_STRTAB {
                this.stringTable = <ptr>(<uint>cArr(this.bytes) + section.sh_offset)
            }
        }

        i=0; for i < len(this.sectionHeaders), i++ {
            section = this.sectionHeaders[i]
            name = this._getELFstr(section.sh_name)
            
            if name == ".text" {
                this.textAddress = <ptr>(<uint>cArr(this.bytes) + section.sh_offset)
                this.textSize = section.sh_size
                this.textIndex = i
            }

            if name == ".strtab" {
                this.symNameTable = <ptr>(<uint>cArr(this.bytes) + section.sh_offset)
            }

            if name == ".symtab" {
                j=0; for j * sizeof(Elf64_Sym) < section.sh_size, j++ {
                    this.symbols[j] = <Elf64_Sym*>(<uint>cArr(this.bytes) + (section.sh_offset + j * sizeof(Elf64_Sym)))
                }
            }

        }

        this._buidGOTtable()
        this._allocateDataSections()
        return true
    }

    dup() objectFile {
        of = *this
        of.isDupped = true
        of.got = []objectFileGotEntry
        ag = <Bah_Array_Type*>of.got

        gotSize = len(this.got) * sizeof(objectFileGotEntry)
        dataSection = this.sectionHeaders[this.dataIndex]
        bssSection = this.sectionHeaders[this.bssIndex]
        textSection = this.sectionHeaders[this.textIndex]
        totalSize = dataSection.sh_size + bssSection.sh_size + textSection.sh_size + gotSize

        memReg = mmap(null, totalSize, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)

        of.dataAddress = <ptr>(<uint>memReg)
        of.bssAddress = <ptr>(<uint>of.dataAddress + dataSection.sh_size)
        of.textAddress = <ptr>(<uint>of.bssAddress + bssSection.sh_size)

        ag.data = <ptr>(<uint>of.textAddress + textSection.sh_size)
        ag.realLength = len(this.got)
        ag.length = len(this.got)
        memcpy(ag.data, cArr(this.got), gotSize)
        GC_registerRoot(ag.data, gotSize)
        

        GC_registerRoot(of.dataAddress, dataSection.sh_size)
        GC_registerRoot(of.bssAddress, bssSection.sh_size)

        memcpy(of.dataAddress, this.dataAddress, dataSection.sh_size)
        memset(of.bssAddress, 0, bssSection.sh_size)
        memcpy(of.textAddress, this.textAddress, textSection.sh_size)

        i=0; for i < len(of.got), i++ {
            of.got[i].addr = of._getSymAddrFromName(of.got[i].name)
        }

        of.weakLinker()
        return of
    }

    getSymbol(name str) ptr {
        i=0; for i < len(this.symbols), i++ {
            sym = this.symbols[i]
            lookupName = this._getELFsymName(sym.st_name)
            if lookupName == name {
                sectnb = sym.st_shndx

                if sectnb != this.dataIndex && sectnb != this.bssIndex && sectnb != this.textIndex {
                    continue
                }

                return <ptr>(<uint>this._getSectAddress(sectnb) + sym.st_value)
            }
        }
        return null
    }

    close() {
        if this.dataAddress == null {
            return
        }
        GC_removeRoot(this.dataAddress)
        GC_removeRoot(this.bssAddress)
        GC_removeRoot(cArr(this.got))

        gotSize = len(this.got) * sizeof(objectFileGotEntry)
        dataSection = this.sectionHeaders[this.dataIndex]
        bssSection = this.sectionHeaders[this.bssIndex]
        textSection = this.sectionHeaders[this.textIndex]
        totalSize = dataSection.sh_size + bssSection.sh_size + textSection.sh_size + gotSize
        
        munmap(this.dataAddress, totalSize)
        
        this.dataAddress = null
        this.bssAddress = null
    }
}