#import "iostream.bah"
#import "string.bah"
#import "path.bah"

#import "lexer.bah"
#import "state.bah"

const ASCII_RESET = "\033[0m"

const ASCII_YELLOW = "\033[33m"
const ASCII_BLUE = "\033[36m"
const ASCII_GREEN = "\033[32m"
const ASCII_MAGENTA = "\033[35m"
const ASCII_GREY = "\033[2m"
const ASCII_RED = "\033[1;31m"

struct compilerError {
    token: bahToken*
    value: bahValue*
    type: bahType*
    
    isWarning: bool
    error: str
}

compilerErrorCallback function(compilerError)

throwErrorTok(t bahToken, s str) {
    if compilerErrorCallback != null {
        compilerErrorCallback(compilerError {
            token: &t
            error: s
        })
    } else {
        println("[jit] compilation error: " + s)
    }
    
    pthread_exit(s)
}

throwError(val bahValue*, err str) {
    if compilerErrorCallback != null {
        compilerErrorCallback(compilerError {
            value: val
            error: err
        })
    } else {
        println("[jit] compilation error: " + err)
    }
    pthread_exit(err)
}

throwTypeError(val bahValue*, type bahType*) {
    if compilerErrorCallback != null {
        compilerErrorCallback(compilerError {
            value: val
            type: type
            error: "wrong type"
        })
    } else {
        println("[jit] compilation error: " + val.type.toStr() + " != " + type.toStr())
    }
    pthread_exit(val.type.toStr() + " != " + type.toStr())
}

throwWarning(val bahValue*, err str) {
    if compilerErrorCallback != null {
        compilerErrorCallback(compilerError {
            value: val
            error: err
            isWarning: true
        })
    } else {
        println("[jit] compilation warning: " + err)
    }
}